{
  "name": "@penster-ai/env",
  "version": "0.1.1",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Penster's single env-parsing boundary: empty string ≡ unset, required enforced by schema.",
  "license": "UNLICENSED",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penster-ai/penster-env.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "zod": "^3.22.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "20.17.12",
    "tsup": "8.3.5",
    "typescript": "5.7.3",
    "vitest": "2.1.8",
    "zod": "3.24.1"
  }
}
